    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "attn-bird-ref"
    key: "implementation_reference"
    value: "Bird/vLLM B12X_MLA_SPARSE is the reference local attention backend for TP4 GLM 5.2 on GX10."
    support_refs {
      node_id: "a-sparse-attn-kernel"
    }
    status: SUPPORTED
