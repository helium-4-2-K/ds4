  semantics {
    entry_id: "attn-glm52-qk-achievable"
    key: "achievability"
    value: "Achievable for GLM 5.2 only with MLA-aware TP/DCP: query-head work is split 16 heads per rank, shared MLA latent/rope cache is available through DCP selected-row reads, and ATTN output projection partials are summed by the TP all-reduce. It is not achievable by naively splitting one KV head into four KV-head shards."
    support_refs {
      node_id: "a-sparse-attn-kernel"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "decode-sparse-attention-arch"
    key: "architecture_rationale"
    value: "Keep the decode parent as ordered orchestration while this child owns the detailed local kernel/collective contract for a-attn-local."
    support_refs {
      node_id: "a-sparse-attn-kernel"
    }
    status: SUPPORTED
  }
