  semantics {
    entry_id: "model-shard-layout-arch"
    key: "architecture_rationale"
    value: "The DS4-native layout is a separate child graph because file format, tensor ownership, and mmap rules are the load-bearing decisions hidden by the parent mapper action."
    support_refs {
      node_id: "a-load-rank-tensors"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "a-map-rank-shards-im"
