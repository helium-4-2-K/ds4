    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "model-shard-layout-guide"
    key: "implementation_guide"
    value: "Use a DS4-native converted shard manifest at runtime rather than ad hoc safetensors discovery; the converter may consume Bird/vLLM rank checkpoints, but serving validates a compact DS4 manifest with hashes, offsets, and ownership spans."
    status: SUPPORTED
  }
  semantics {
    entry_id: "a-map-rank-shards-nd"
