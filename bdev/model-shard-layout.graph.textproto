    semantics {
      entry_id: "a-load-rank-tensors-ov"
      key: "overview"
      value: "Memory-map only current-rank and required replicated tensor slices after hash and byte-range validation; reject foreign-rank, stale-hash, missing-span, overlapping-span, and unsupported-layout inputs before touching resident engine state."
