      }
      member_refs {
        node_id: "s-rank-plan"
      }
      semantics {
        entry_id: "dec-r0-dcp"
        key: "dcp_distribution"
        value: "owns DCP context shard 0; selected rows can be read/exchanged according to DCP global top-k results"
        status: SUPPORTED
