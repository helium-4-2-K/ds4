    }
    support_refs {
      node_id: "a-qkv-shard"
    }
    support_refs {
      node_id: "a-sample"
    }
  }
  semantics {
    entry_id: "token-in"
    key: "input_use"
    value: "Consumes exactly one previous token through token-in."
    object_ref {
      port {
        graph_boundary {
        }
        direction: PORT_DIRECTION_INPUT
        port_id: "token-in"
      }
    }
    support_refs {
      node_id: "d-token-in"
    }
    status: SUPPORTED
  }
  semantics {
