    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "dec-ef"
    key: "effect"
    value: "one token sampled; TP KV shards and the replicated decode cursor advance by one position"
    support_refs {
      node_id: "a-sample"
    }
    support_refs {
      node_id: "s-kv"
    }
    support_refs {
      node_id: "s-kv-cursor"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "decode-state-read-no-effect"
    key: "no_effect"
    value: "Read-only decode state dependencies are consumed by the trace but not mutated; only s-kv update edges advance state."
    support_refs {
      node_id: "s-model"
    }
    support_refs {
      node_id: "s-rank-plan"
    }
    support_refs {
