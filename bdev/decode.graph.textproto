graph {
  overall_semantic {
    overview: "Given token j-1, broadcast replicated hidden to TP ranks, run every GLM 5.2 layer with rank-local Q/head/expert shards and explicit ATTN/FFN collectives, gather logits shards, and sample token j."
    support_refs {
      node_id: "a-attn-allreduce"
    }
    support_refs {
      node_id: "a-embed-broadcast"
    }
    support_refs {
      node_id: "a-ffn-allreduce"
    }
