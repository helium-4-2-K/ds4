  operations {
    operation_id: "op-decode"
    name: "decode-token-j-tp4"
    overview: "One-token GLM 5.2 decode with TP=4/DCP4 over four GX10 ranks."
    members {
      ref {
        node_id: "a-attn-allreduce"
      }
      role: "ATTN collective"
    }
    members {
      ref {
        node_id: "a-attn-local"
      }
      role: "local sparse MLA attention/head shards"
    }
    members {
      ref {
        node_id: "a-dcp-topk"
      }
      role: "DCP global sparse top-k"
    }
    members {
      ref {
        node_id: "a-embed-broadcast"
      }
      role: "broadcast replicated input"
    }
    members {
      ref {
        node_id: "a-ffn-allreduce"
      }
      role: "FFN collective"
    }
    members {
      ref {
        node_id: "a-ffn-local"
      }
      role: "local FFN/expert shards"
    }
    members {
      ref {
        node_id: "a-ffn-route"
      }
      role: "router/top-k expert selection"
    }
    members {
      ref {
        node_id: "a-logits-gather"
      }
      role: "logits gather/top-k"
    }
    members {
      ref {
        node_id: "a-qkv-shard"
      }
      role: "QKV/MLA projection and cache append"
    }
    members {
      ref {
        node_id: "a-sample"
      }
      role: "sampling"
    }
    members {
      ref {
        node_id: "a-vocab-shard"
      }
      role: "vocab shards"
    }
    semantics {
      entry_id: "op-decode-dist"
      key: "distribution_scope"
      value: "rank-local shards/partials become replicated only through explicit broadcast/all-reduce/gather actions"
      status: SUPPORTED
    }
    semantics {
      entry_id: "op-decode-order"
      key: "ordering"
      value: "embed/broadcast -> QKV/MLA cache append -> DCP global top-k -> local sparse MLA attention -> ATTN all-reduce -> expert routing -> local FFN -> FFN all-reduce -> loop/final vocab -> logits gather -> sample"
      status: SUPPORTED
    }
    semantics {
      entry_id: "op-decode-qk"
      key: "qk_distribution"
      value: "Q components are distributed by query-head span; K components use shared MLA latent plus rank-owned k_b reconstruction slices, not KV-head sharding."
      status: SUPPORTED
    }
    end_goals {
      goal_id: "goal-one-token"
      intent: "Produce exactly one sampled token j and advance TP/DCP KV shards for position j."
      bindings {
        ref {
          node_id: "d-token-out"
        }
        role: "sampled token"
        semantics {
          entry_id: "goal-out-token"
          key: "output"
          value: "token j sampled on coordinator"
          status: SUPPORTED
        }
      }
      bindings {
        ref {
          node_id: "s-kv"
        }
        role: "advanced TP/DCP KV"
        semantics {
          entry_id: "goal-kv-shards"
          key: "state_update"
          value: "TP/DCP KV shards advanced for ranks 0..3"
          status: SUPPORTED
        }
      }
    }
  }
  architecture {
    overview: "One autoregressive token is computed by four TP ranks running every layer in lockstep."
    rationale: "The distributed boundaries are collectives, not layer handoffs. Rank-local QKV/head/expert/logits shards and additive partials are distinct DATA occurrences until broadcast/all-reduce/gather actions produce replicated or leader-visible DATA."
    components {
      component_id: "dec-collectives"
      name: "TP collectives"
      kind: "collective-boundary"
      overview: "Broadcast, all-reduce, and gather/top-k actions that convert between rank-local and replicated/leader-visible occurrences."
      member_refs {
        node_id: "a-attn-allreduce"
      }
      member_refs {
        node_id: "a-embed-broadcast"
      }
      member_refs {
        node_id: "a-ffn-allreduce"
      }
      member_refs {
        node_id: "a-logits-gather"
      }
      semantics {
        entry_id: "dec-coll"
        key: "collective"
        value: "broadcast + all_reduce_sum + gather_or_distributed_topk"
        status: SUPPORTED
      }
    }
    components {
      component_id: "dec-dcp-mla-cache"
      name: "DCP4 MLA sparse cache"
      kind: "distributed-cache-and-selection"
      overview: "The decode-context partition stores GLM 5.2 MLA latent rows and sparse index metadata by DCP rank; global top-k selection returns the rows each query-head shard needs before local attention."
      member_refs {
        node_id: "a-attn-local"
      }
      member_refs {
        node_id: "a-dcp-topk"
      }
      member_refs {
        node_id: "d-dcp-selection"
      }
      member_refs {
        node_id: "d-mla-cache-row"
      }
      member_refs {
        node_id: "s-kv"
      }
      semantics {
        entry_id: "dec-dcp-cache-topk"
        key: "collective"
        value: "dcp_global_topk_merge"
        status: SUPPORTED
      }
      semantics {
        entry_id: "dec-dcp-cache-scope"
        key: "distribution_scope"
        value: "rank_local_shard"
        status: SUPPORTED
      }
      semantics {
        entry_id: "dec-dcp-cache-mla"
        key: "qk_distribution"
        value: "K storage is MLA latent/rope cache, not four independent KV-head caches."
        status: SUPPORTED
      }
    }
    components {
      component_id: "dec-rank0"
      name: "TP rank 0"
      kind: "tp-rank"
