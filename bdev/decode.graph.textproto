      node_id: "a-sample"
    }
    support_refs {
      node_id: "d-token-out"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "rat-decode-tp4"
    key: "architecture_rationale"
    value: "The token path is tensor parallel: layer i is evaluated by all four ranks concurrently. Rank-local partials are never treated as full hidden state until a dedicated collective action produces a distinct replicated DATA occurrence."
    support_refs {
      node_id: "a-attn-allreduce"
    }
    support_refs {
      node_id: "a-ffn-allreduce"
    }
    support_refs {
      node_id: "a-qkv-shard"
    }
    support_refs {
      node_id: "d-hidden-layer-out"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "decode-bird-collectives"
    key: "collective_reference"
    value: "Bird/vLLM baseline uses NCCL 2.30.4 over IB/RoCE with four channels; DwarfStar TP collectives should provide equivalent broadcast, all_reduce_sum, and gather/top-k semantics."
    support_refs {
      node_id: "a-attn-allreduce"
    }
    support_refs {
      node_id: "a-embed-broadcast"
    }
    support_refs {
      node_id: "a-ffn-allreduce"
    }
    support_refs {
      node_id: "a-logits-gather"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "dec-design"
    key: "design_subject"
    value: "one-token GLM 5.2 decode with TP=4"
    status: SUPPORTED
  }
  semantics {
    entry_id: "action-decode-token-im"
    key: "implementation_choice"
    value: "requires_new_glm52_tp4_support"
    support_refs {
      node_id: "a-attn-allreduce"
    }
    support_refs {
      node_id: "a-ffn-allreduce"
    }
    support_refs {
      node_id: "a-qkv-shard"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "decode-bird-dcp"
    key: "implementation_detail"
    value: "DCP4 in the Bird/vLLM baseline is a concrete reference for decode-context/KV-attention partitioning and should inform the QKV/MLA and local attention shard design."
    support_refs {
      node_id: "a-attn-local"
    }
    support_refs {
      node_id: "a-qkv-shard"
    }
    support_refs {
      node_id: "s-kv"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "dec-bird-ref"
    key: "implementation_reference"
    value: "Use Bird/vLLM serving command as the operational decode reference: vllm serve /model with tensor-parallel-size 4, decode-context-parallel-size 4, fp8_ds_mla KV, and DSpark BF16 speculator."
    support_refs {
      node_id: "a-attn-local"
    }
    support_refs {
      node_id: "a-logits-gather"
    }
    support_refs {
      node_id: "a-qkv-shard"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "decode-bird-baseline"
    key: "implementation_reference"
    value: "Bird/vLLM reference decode runs TP4 plus DCP4: --tensor-parallel-size 4, --decode-context-parallel-size 4, B12X_MLA_SPARSE attention, fp8_ds_mla KV with skip layers 78-82, and logits/sampling exposed through vLLM serve."
    support_refs {
      node_id: "a-attn-local"
    }
    support_refs {
      node_id: "a-logits-gather"
    }
    support_refs {
      node_id: "a-qkv-shard"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "decode-implementation-seams"
    key: "implementation_requirement"
    value: "Native DS4 needs TP4 rank-group startup, rank-local GLM checkpoint shards, MLA-aware Q/K/V shard kernels, DCP4 selected-row exchange, four-way routed expert ownership, TP all-reduce/gather collectives, and token/sample broadcast."
    status: SUPPORTED
  }
  semantics {
    entry_id: "dec-nd"
    key: "no_diagnostic"
    value: "none"
    support_refs {
      node_id: "a-sample"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "dec-no-guide"
    key: "no_implementation_guide"
    value: "none"
    status: SUPPORTED
  }
  semantics {
    entry_id: "dec-scenario"
    key: "operating_scenario"
    value: "All four ranks run each layer in lockstep; token j+1 waits until token j has completed logits gather and sampling."
    status: SUPPORTED
  }
  semantics {
    entry_id: "dec-order"
    key: "ordering"
    value: "01 embed+broadcast; per layer i: 02 MLA/QKV projection and cache append, 03 DCP4 global sparse top-k selection, 04 local sparse MLA attention over rank-owned query heads, 05 ATTN all-reduce to replicated hidden, 06 route top-8/shared experts, 07 local routed/shared FFN shards, 08 FFN all-reduce to replicated next hidden; loop layers; 09 vocab logits shards; 10 gather/top-k logits; 11 sample token j."
    status: SUPPORTED
  }
  semantics {
    entry_id: "decode-glm52-qk-mla-split"
    key: "qk_distribution"
    value: "GLM 5.2 uses MLA-style attention. With TP=4, Q is sharded by query head: rank0 heads 0-15, rank1 heads 16-31, rank2 heads 32-47, rank3 heads 48-63. K is not sharded as four KV-head groups because n_head_kv=1; the KV path produces a shared 512-wide MLA latent plus a 64-wide rope component, and each rank uses its owned k_b slices for its 16 query heads to reconstruct the non-rope K component from that latent."
    support_refs {
      node_id: "a-attn-local"
    }
    support_refs {
      node_id: "a-qkv-shard"
    }
    support_refs {
      node_id: "s-kv"
    }
    support_refs {
      node_id: "s-model"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "dec-target"
    key: "target_state"
    value: "token j sampled; TP KV shards for ranks 0..3 contain position j"
    status: SUPPORTED
  }
