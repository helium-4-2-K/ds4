          status: SUPPORTED
        }
      }
    }
  }
  architecture {
    overview: "Four GX10 machines host one GLM 5.2 tensor-parallel serving group. Rank 0 hosts the public API, sampling coordinator, and NCCL master endpoint; ranks 1-3 host headless worker processes. Every rank stores its rank-specific model shard files, TP-owned QKV/MLA/head/expert/vocab shards for every layer, and rank-owned KV/MLA cache slices."
    rationale: "The deployment is TP4, not pipeline parallelism: no machine owns a contiguous layer range. Each rank runs every layer in lockstep over its tensor shards, then explicit broadcast/all-reduce/gather collectives convert rank-local shards or partials into replicated or coordinator-visible values."
    components {
      component_id: "cmp-rank0"
      name: "rank 0 GX10 API/master 192.168.0.40"
      kind: "tp-rank-api-master"
      overview: "Hosts the rank 0 vLLM/Bird-compatible worker, public API on port 8216, NCCL master endpoint on fabric IP 10.100.185.3, rank0 sharded-state checkpoint files under glm52-full-tp4-mtp-rank0, rank0 QKV/MLA/head/expert/vocab shards for every GLM 5.2 layer, rank0 KV/MLA cache slices, and coordinator-visible logits/top-k sampling state."
      member_refs {
        node_id: "data-request"
      }
      member_refs {
        node_id: "data-token"
      }
      member_refs {
        node_id: "state-kv"
      }
      member_refs {
        node_id: "state-model-leader"
      }
      member_refs {
        node_id: "state-model-worker"
      }
      member_refs {
        node_id: "state-tp"
      }
      semantics {
        entry_id: "cmp-r0-decode"
        key: "decode_role"
        value: "runs every layer for owned tensor shards, participates in TP collectives, gathers logits/top-k, samples token j"
        status: SUPPORTED
      }
      semantics {
        entry_id: "cmp-r0-dist"
        key: "distribution_scope"
        value: "rank_local_shard plus leader_only API/sampling state"
        status: SUPPORTED
      }
      semantics {
        entry_id: "cmp-r0-fabric"
        key: "fabric_ip"
        value: "10.100.185.3"
        status: SUPPORTED
      }
      semantics {
        entry_id: "cmp-r0-host"
        key: "host_ip"
        value: "192.168.0.40"
        status: SUPPORTED
      }
      semantics {
        entry_id: "cmp-r0-kv"
        key: "hosted_kv"
        value: "rank0 fp8_ds_mla KV/MLA cache slice and replicated cursor metadata"
        status: SUPPORTED
      }
      semantics {
        entry_id: "cmp-r0-model"
        key: "hosted_model_shards"
        value: "20 base rank0 safetensors parts plus one MTP rank0 safetensors part; owns rank0 tensor shards for all layers"
        status: SUPPORTED
      }
      semantics {
        entry_id: "cmp-r0-process"
        key: "hosted_process"
        value: "vllm serve /model with --node-rank 0 --host 0.0.0.0 --port 8216"
        status: SUPPORTED
      }
      semantics {
        entry_id: "cmp-r0-rank"
        key: "tp_rank"
        value: "0 of 4"
        status: SUPPORTED
      }
    }
