schema_version: "blueprint-graph/v1"
graph_id: "serve"
display_name: "DwarfStar GLM 5.2 TP=4 serving on four GX10 machines"
graph_version: "3.0"
lifecycle: DRAFT
schema_ref: "blueprint-schema/blueprint/v1/blueprint.proto"
type_schema_ref: "serve.types.proto"
input_ports {
  port_id: "root-model"
  node_id: "state-model-leader"
  type_ref: "blueprint.work.ds4_arch.model"
  cardinality: PORT_CARDINALITY_EXACTLY_ONE
}
input_ports {
  port_id: "root-req"
  node_id: "data-request"
  type_ref: "blueprint.work.ds4_arch.ChatRequest"
  cardinality: PORT_CARDINALITY_EXACTLY_ONE
}
input_ports {
  port_id: "root-tok"
  node_id: "data-token"
  type_ref: "blueprint.work.ds4_arch.Token"
  cardinality: PORT_CARDINALITY_ZERO_OR_MORE
}
output_ports {
  port_id: "root-tok"
  node_id: "data-token"
  type_ref: "blueprint.work.ds4_arch.Token"
  cardinality: PORT_CARDINALITY_ZERO_OR_MORE
}
graph {
  overall_semantic {
    overview: "Serve GLM 5.2 with tensor parallel degree 4 across four GX10 machines. Every rank participates in every decoder layer, owns rank-local Q/head/expert/vocab shards, uses explicit collectives to rebuild replicated hidden state, and returns a sampled token to the coordinator."
    support_refs {
      node_id: "action-decode-token"
    }
    support_refs {
      node_id: "action-tp-group"
    }
    support_refs {
      node_id: "state-tp"
    }
  }
  semantics {
    entry_id: "rat-tp4"
    key: "architecture_rationale"
    value: "This target is tensor parallelism, not layer pipeline parallelism: the full layer order is identical on all four ranks, while large tensors are sharded and synchronized with authored broadcast, all-reduce, and gather actions. Current repo evidence says GLM 5.2 CUDA TP is not implemented yet, so the blueprint records the intended target and its implementation gap explicitly."
    support_refs {
      node_id: "action-decode-token"
    }
    support_refs {
      node_id: "action-tp-group"
    }
    support_refs {
      node_id: "state-model-worker"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-design"
    key: "design_subject"
    value: "GLM 5.2 DwarfStar serving with TP=4 over four GX10 machines."
    support_refs {
      node_id: "action-decode-token"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-gap"
    key: "implementation_gap"
    value: "Current code rejects --cuda-tensor-parallel for GLM 5.2; implementation must add GLM 5.2 TP kernels/collectives for this target."
    support_refs {
      node_id: "action-tp-group"
    }
    support_refs {
      node_id: "state-model-worker"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-gap-bird-reference"
    key: "implementation_gap_reference"
    value: "DwarfStar GLM 5.2 TP should be designed against the Bird/vLLM TP4 behavior, while preserving that DS4 code still needs native GLM 5.2 TP support."
    support_refs {
      node_id: "state-model-worker"
    }
    support_refs {
      node_id: "state-tp"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-bird-baseline"
    key: "implementation_reference"
    value: "Validated external serving baseline: Bird vLLM commit b7abab517 serving QuantTrio GLM-5.2 with TP4, PP1, DCP4, one rank per GX10, B12X_MLA_SPARSE attention, fp8_ds_mla KV, NCCL 2.30.4, four channels, and served name glm-5.2-full-bird-dspark-bf16-nccl2304-ch4."
    support_refs {
      node_id: "action-decode-token"
    }
    support_refs {
      node_id: "action-tp-group"
    }
    support_refs {
      node_id: "state-tp"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-no-guide"
    key: "no_implementation_guide"
    value: "none"
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-scenario"
    key: "operating_scenario"
    value: "Four GX10 ranks form one TP group. Rank0 coordinates API/sampling; all ranks run every layer in lockstep with rank-owned tensor shards and collectives."
    support_refs {
      node_id: "action-decode-token"
    }
    support_refs {
      node_id: "action-tp-group"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-bird-operational-topology"
    key: "operational_baseline"
    value: "Bird/vLLM launch uses rank0 at 192.168.0.40, ranks1-3 at 192.168.0.240/0.99/0.39, fabric rail-A 10.100.185.3/1/2/4, and local per-rank sharded checkpoints."
    support_refs {
      node_id: "action-serve-open"
    }
    support_refs {
      node_id: "state-model-worker"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-order"
    key: "ordering"
    value: "01 open/load TP shards; 02 form TP collective group; 03 accept request; 04 prefill via TP collectives; 05 decode token j via TP child graph; 06 stream token; 07 repeat until stop; 08 checkpoint TP-aware KV."
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-glm52-qk-hosting"
    key: "qk_distribution"
    value: "Per-rank hosting follows the GLM 5.2 MLA split: every rank hosts all-layer Q/head/output/FFN/vocab shards for its TP rank, while the K path consists of shared MLA latent/rope cache semantics plus rank-owned per-query-head k_b reconstruction slices. Bird/vLLM TP4+B12X_MLA_SPARSE is the concrete external proof point; native DS4 must generalize current TP attention split behavior to TP4 and MLA/DCP semantics."
    support_refs {
      node_id: "action-decode-token"
    }
    support_refs {
      node_id: "state-kv"
    }
    support_refs {
      node_id: "state-model-worker"
    }
    support_refs {
      node_id: "state-tp"
    }
    status: SUPPORTED
  }
  semantics {
    entry_id: "serve-target"
    key: "target_state"
    value: "Client receives sampled tokens; rank-local TP KV shards and replicated decode cursor advance consistently."
    support_refs {
      node_id: "data-token"
    }
    support_refs {
      node_id: "state-kv"
    }
    status: SUPPORTED
  }
  nodes {
    id: "action-decode-token"
