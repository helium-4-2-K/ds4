  semantics {
    entry_id: "qkv-glm52-qk-mla-split"
    key: "qk_distribution"
    value: "Q is sharded by query head: rank0 heads 0-15, rank1 16-31, rank2 32-47, rank3 48-63. K is not split into four KV heads; GLM 5.2 has one KV head, so each rank reconstructs non-RoPE K for its query heads from shared kv_lora[512] using rank-owned k_b slices and combines it with k_rope[64]."
    support_refs {
      node_id: "a-qkv-mla-kernel"
    }
    status: SUPPORTED
  }
